APP_NAME=Video AI Backend
DEBUG=True
HOST=0.0.0.0
PORT=8000
# true = prompt-only (no Kie.ai / no credits). false = full production pipeline.
DEVELOPMENT_MODE=true

UPLOAD_FOLDER=app/uploads
GENERATED_FOLDER=app/generated
STATIC_FOLDER=app/static

MAX_UPLOAD_SIZE=20971520
MAX_UPLOAD_COUNT=10
MIN_UPLOAD_COUNT=1
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used for local library thumbnails only. Generation images are uploaded to Kie File API.
PUBLIC_BASE_URL=http://127.0.0.1:8000

KIE_API_KEY=d14b05d6d3f1ac993f9cb6b762f33c37
KIE_BASE_URL=https://api.kie.ai
# Official File Upload API (https://docs.kie.ai/file-upload-api/quickstart)
KIE_FILE_BASE_URL=https://kieai.redpandaai.co
KIE_TIMEOUT=60
# Seedance 1.0 Pro Fast (market card) = bytedance/v1-pro-fast-image-to-video
# Also: bytedance/seedance-2 | seedance-2-fast | seedance-2-mini
# Docs: https://docs.kie.ai/market/bytedance/v1-pro-fast-image-to-video
KIE_MODEL=bytedance/v1-pro-fast-image-to-video
# V1 Pro Fast: 720p|1080p; duration 5|10 (16 credits / 10s on Market)
KIE_RESOLUTION=720p
KIE_DURATION=5

# Vision analysis provider: openrouter | ollama
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_TIMEOUT=120

# Kept for AI_PROVIDER=ollama fallback
OLLAMA_MODEL=gemma3:4b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT=120

# MongoDB metadata store (videos collection). Do not store MP4 binaries.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=video_ai
